{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "#ArgumentDefinition": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23StringArgument"
                },
                {
                    "$ref": "#/$defs/%23IntegerArgument"
                },
                {
                    "$ref": "#/$defs/%23NumberArgument"
                },
                {
                    "$ref": "#/$defs/%23BooleanArgument"
                },
                {
                    "$ref": "#/$defs/%23ArrayArgument"
                },
                {
                    "$ref": "#/$defs/%23ObjectArgument"
                }
            ]
        },
        "#ArgumentType": {
            "enum": [
                "string",
                "integer",
                "number",
                "boolean",
                "array",
                "object"
            ]
        },
        "#ArrayArgument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "default": {
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "items": {
                    "$ref": "#/$defs/%23ArgumentDefinition"
                },
                "max_items": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "min_items": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "required": {
                    "type": "boolean"
                },
                "type": {
                    "$ref": "#/$defs/%23ArgumentType",
                    "const": "array"
                }
            },
            "required": [
                "items",
                "type"
            ]
        },
        "#BooleanArgument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "default": {
                    "type": "boolean"
                },
                "description": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "type": {
                    "$ref": "#/$defs/%23ArgumentType",
                    "const": "boolean"
                }
            },
            "required": [
                "type"
            ]
        },
        "#Capability": {
            "enum": [
                "agenda",
                "closed-items",
                "commands",
                "entity-details",
                "cli",
                "http",
                "jobs",
                "events",
                "ui",
                "health"
            ]
        },
        "#CredentialCondition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "argument": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "equals": {
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": [
                "argument",
                "equals"
            ]
        },
        "#CredentialRegistration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "required_when": {
                    "$ref": "#/$defs/%23CredentialCondition"
                }
            }
        },
        "#EntityCapability": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23StandardEntityCapability"
                },
                {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
            ]
        },
        "#EntityTypeRegistration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "capabilities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23EntityCapability"
                    }
                }
            },
            "required": [
                "capabilities"
            ]
        },
        "#Identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "#IntegerArgument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "default": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                },
                "enum": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "maximum": {
                    "type": "integer"
                },
                "minimum": {
                    "type": "integer"
                },
                "required": {
                    "type": "boolean"
                },
                "type": {
                    "$ref": "#/$defs/%23ArgumentType",
                    "const": "integer"
                }
            },
            "required": [
                "type"
            ]
        },
        "#NumberArgument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "default": {
                    "type": "number"
                },
                "description": {
                    "type": "string"
                },
                "enum": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "maximum": {
                    "type": "number"
                },
                "minimum": {
                    "type": "number"
                },
                "required": {
                    "type": "boolean"
                },
                "type": {
                    "$ref": "#/$defs/%23ArgumentType",
                    "const": "number"
                }
            },
            "required": [
                "type"
            ]
        },
        "#ObjectArgument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "additional_properties": {
                    "type": "boolean"
                },
                "default": {
                    "const": {}
                },
                "description": {
                    "type": "string"
                },
                "properties": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/%23ArgumentDefinition"
                    }
                },
                "required": {
                    "type": "boolean"
                },
                "type": {
                    "$ref": "#/$defs/%23ArgumentType",
                    "const": "object"
                }
            },
            "required": [
                "type"
            ]
        },
        "#Permission": {
            "enum": [
                "database",
                "network",
                "credentials"
            ]
        },
        "#PluginRuntime": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "agenda_seed": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "entrypoint": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
                },
                "migration_set": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                }
            },
            "required": [
                "entrypoint"
            ]
        },
        "#StandardEntityCapability": {
            "enum": [
                "entity.annotate",
                "entity.attach",
                "activity.read",
                "lifecycle.complete",
                "lifecycle.reopen",
                "lifecycle.acknowledge",
                "lifecycle.dismiss",
                "entity.edit",
                "entity.delete"
            ]
        },
        "#StringArgument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "default": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "enum": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "max_length": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "min_length": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "pattern": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "type": {
                    "$ref": "#/$defs/%23ArgumentType",
                    "const": "string"
                }
            },
            "required": [
                "type"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "arguments": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/%23ArgumentDefinition"
            }
        },
        "capabilities": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23Capability"
            }
        },
        "credentials": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/%23CredentialRegistration"
            },
            "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
        },
        "entity_types": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/%23EntityTypeRegistration"
            },
            "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "permissions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23Permission"
            }
        },
        "plugin_api": {
            "type": "string",
            "minLength": 1
        },
        "runtime": {
            "$ref": "#/$defs/%23PluginRuntime"
        },
        "schema_version": {
            "const": "mission-control.plugin/v1"
        },
        "version": {
            "type": "string",
            "minLength": 1
        }
    },
    "required": [
        "capabilities",
        "id",
        "name",
        "plugin_api",
        "schema_version",
        "version"
    ]
}
