{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "mission-control.family-rewards.config/v1",
  "type": "object", "additionalProperties": false, "required": ["settings", "credentials"],
  "properties": {"credentials": {"const": {}}, "settings": {
    "type": "object", "additionalProperties": false,
    "required": ["timezone", "school_day_cap_minutes", "non_school_day_cap_minutes", "tasks", "windows"],
    "properties": {
      "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
      "school_day_cap_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
      "non_school_day_cap_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
      "tasks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "minutes"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "minutes": {"type": "integer", "minimum": 1, "maximum": 240}}
      }},
      "windows": {"type": "array", "maxItems": 16, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "weekdays", "starts_at", "ends_at"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "weekdays": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
          "starts_at": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "ends_at": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}}
      }}
    }
  }}
}
