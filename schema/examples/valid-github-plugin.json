{
  "schema_version": "mission-control.plugin/v1",
  "id": "github",
  "name": "GitHub",
  "version": "0.1.0",
  "plugin_api": ">=1.0.0 <2.0.0",
  "capabilities": ["jobs", "events", "health"],
  "arguments": {
    "repository": {
      "type": "string",
      "required": true,
      "description": "Repository in owner/name form"
    },
    "poll_interval_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400,
      "default": 300
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["issues", "pull_requests", "releases"]
      },
      "default": ["issues", "pull_requests"]
    }
  }
}
