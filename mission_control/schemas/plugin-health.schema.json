{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "#Identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "#PluginID": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "#Timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "checked_at": {
            "$ref": "#/$defs/%23Timestamp"
        },
        "code": {
            "$ref": "#/$defs/%23Identifier"
        },
        "components": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "code": {
                        "$ref": "#/$defs/%23Identifier"
                    },
                    "detail": {
                        "type": "string",
                        "not": {
                            "const": ""
                        }
                    },
                    "id": {
                        "$ref": "#/$defs/%23Identifier"
                    },
                    "label": {
                        "type": "string",
                        "not": {
                            "pattern": "^\\s*$"
                        }
                    },
                    "last_success_at": {
                        "$ref": "#/$defs/%23Timestamp"
                    },
                    "state": {
                        "enum": [
                            "starting",
                            "ready",
                            "degraded",
                            "failed"
                        ]
                    }
                },
                "required": [
                    "code",
                    "detail",
                    "id",
                    "label",
                    "state"
                ]
            }
        },
        "detail": {
            "type": "string",
            "not": {
                "const": ""
            }
        },
        "last_success_at": {
            "$ref": "#/$defs/%23Timestamp"
        },
        "plugin_id": {
            "$ref": "#/$defs/%23PluginID"
        },
        "schema_version": {
            "const": "mission-control.plugin-health/v2"
        },
        "state": {
            "enum": [
                "starting",
                "ready",
                "degraded",
                "failed"
            ]
        }
    },
    "required": [
        "checked_at",
        "code",
        "components",
        "detail",
        "plugin_id",
        "schema_version",
        "state"
    ]
}
