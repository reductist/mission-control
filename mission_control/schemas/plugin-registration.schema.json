{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "#Capability": {
            "enum": [
                "agenda",
                "closed-items",
                "commands",
                "entity-details",
                "cli",
                "http",
                "jobs",
                "events",
                "ui",
                "health"
            ]
        },
        "#ConfigurationContract": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "defaults_resource": {
                    "$ref": "#/$defs/%23ResourceName"
                },
                "document_version": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                },
                "presentation_resource": {
                    "$ref": "#/$defs/%23ResourceName"
                },
                "schema_resource": {
                    "$ref": "#/$defs/%23ResourceName"
                }
            },
            "required": [
                "defaults_resource",
                "document_version",
                "presentation_resource",
                "schema_resource"
            ]
        },
        "#EntityCapability": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23StandardEntityCapability"
                },
                {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
            ]
        },
        "#EntityTypeRegistration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "capabilities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23EntityCapability"
                    }
                }
            },
            "required": [
                "capabilities"
            ]
        },
        "#Permission": {
            "enum": [
                "database",
                "network",
                "credentials"
            ]
        },
        "#PluginRuntime": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "agenda_seed": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "entrypoint": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
                },
                "migration_set": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                }
            },
            "required": [
                "entrypoint"
            ]
        },
        "#ResourceName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "#StandardEntityCapability": {
            "enum": [
                "entity.annotate",
                "entity.attach",
                "activity.read",
                "lifecycle.complete",
                "lifecycle.reopen",
                "lifecycle.acknowledge",
                "lifecycle.dismiss",
                "entity.edit",
                "entity.delete"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "capabilities": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23Capability"
            }
        },
        "configuration": {
            "$ref": "#/$defs/%23ConfigurationContract"
        },
        "entity_types": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/%23EntityTypeRegistration"
            },
            "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "permissions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23Permission"
            }
        },
        "plugin_api": {
            "type": "string",
            "minLength": 1
        },
        "runtime": {
            "$ref": "#/$defs/%23PluginRuntime"
        },
        "schema_version": {
            "const": "mission-control.plugin/v2"
        },
        "version": {
            "type": "string",
            "minLength": 1
        }
    },
    "required": [
        "capabilities",
        "configuration",
        "id",
        "name",
        "plugin_api",
        "schema_version",
        "version"
    ]
}
