{
  "schema_version": "mission-control.plugin/v3",
  "id": "home-search",
  "name": "Home Search",
  "version": "0.1.0",
  "plugin_api": ">=1.0.0 <2.0.0",
  "capabilities": ["agenda", "commands", "entity-details"],
  "runtime": {
    "entrypoint": "mission_control.builtin_plugins.home_search:activate",
    "migration_set": "home_search_v1"
  },
  "permissions": ["database"],
  "configuration": {
    "document_version": "mission-control.home-search.config/v1",
    "schema_resource": "config.schema.json",
    "defaults_resource": "config.defaults.json",
    "presentation_resource": "config.presentation.json"
  },
  "entity_types": {
    "search": {
      "capabilities": ["activity.read", "home-search.snapshot.import"]
    },
    "candidate": {
      "capabilities": [
        "entity.annotate",
        "activity.read",
        "home-search.review.set-status"
      ]
    }
  }
}
