{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "configuration_schema": {
            "type": "string",
            "minLength": 1
        },
        "defaults": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "credentials": {
                    "const": {}
                },
                "settings": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "schema_version": {
            "const": "mission-control.plugin-config-defaults/v1"
        }
    },
    "required": [
        "configuration_schema",
        "defaults",
        "schema_version"
    ]
}
