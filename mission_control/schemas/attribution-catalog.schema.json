{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "#AccentDocument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "target": {
                    "$ref": "#/$defs/%23AccentTarget"
                },
                "token": {
                    "$ref": "#/$defs/%23AccentToken"
                }
            },
            "required": [
                "target",
                "token"
            ]
        },
        "#AccentTarget": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23PrincipalTarget"
                },
                {
                    "$ref": "#/$defs/%23PluginTarget"
                },
                {
                    "$ref": "#/$defs/%23ConnectionTarget"
                },
                {
                    "$ref": "#/$defs/%23CollectionTarget"
                }
            ]
        },
        "#AccentToken": {
            "enum": [
                "accent-1",
                "accent-2",
                "accent-3",
                "accent-4",
                "accent-5",
                "accent-6",
                "accent-7",
                "accent-8"
            ]
        },
        "#CollectionTarget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "collection_id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "connection_id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "kind": {
                    "const": "collection"
                },
                "plugin_id": {
                    "$ref": "#/$defs/%23PluginID"
                }
            },
            "required": [
                "collection_id",
                "connection_id",
                "kind",
                "plugin_id"
            ]
        },
        "#ConnectionTarget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "connection_id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "kind": {
                    "const": "connection"
                },
                "plugin_id": {
                    "$ref": "#/$defs/%23PluginID"
                }
            },
            "required": [
                "connection_id",
                "kind",
                "plugin_id"
            ]
        },
        "#Identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "#PluginID": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "#PluginTarget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "plugin"
                },
                "plugin_id": {
                    "$ref": "#/$defs/%23PluginID"
                }
            },
            "required": [
                "kind",
                "plugin_id"
            ]
        },
        "#PrincipalDocument": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "$ref": "#/$defs/%23PrincipalID"
                },
                "kind": {
                    "enum": [
                        "person",
                        "group"
                    ]
                },
                "label": {
                    "type": "string",
                    "not": {
                        "pattern": "^\\s*$"
                    }
                }
            },
            "required": [
                "id",
                "kind",
                "label"
            ]
        },
        "#PrincipalID": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "#PrincipalTarget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "principal"
                },
                "principal_id": {
                    "$ref": "#/$defs/%23PrincipalID"
                }
            },
            "required": [
                "kind",
                "principal_id"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "accents": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23AccentDocument"
            }
        },
        "principals": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23PrincipalDocument"
            }
        },
        "schema_version": {
            "const": "mission-control.attribution-catalog/v1"
        }
    },
    "required": [
        "accents",
        "principals",
        "schema_version"
    ]
}
