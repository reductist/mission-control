{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "#Action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "affordances": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23EntityAffordance"
                    }
                },
                "attribution": {
                    "$ref": "#/$defs/%23EntryAttribution"
                },
                "context": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "detail": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "kind": {
                    "const": "action"
                },
                "revision": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "source": {
                    "$ref": "#/$defs/%23SourceRef"
                },
                "state": {
                    "$ref": "#/$defs/%23ActionState"
                },
                "timing": {
                    "$ref": "#/$defs/%23ActionTiming"
                },
                "title": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                }
            },
            "required": [
                "attribution",
                "id",
                "kind",
                "source",
                "state",
                "timing",
                "title"
            ]
        },
        "#ActionState": {
            "enum": [
                "ready",
                "blocked",
                "waiting"
            ]
        },
        "#ActionTiming": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23Anytime"
                },
                {
                    "$ref": "#/$defs/%23DueOn"
                },
                {
                    "$ref": "#/$defs/%23DueAt"
                },
                {
                    "$ref": "#/$defs/%23Window"
                }
            ]
        },
        "#AgendaEntry": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23Initiative"
                },
                {
                    "$ref": "#/$defs/%23Action"
                },
                {
                    "$ref": "#/$defs/%23Event"
                }
            ]
        },
        "#AllDay": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ends_before": {
                    "$ref": "#/$defs/%23Date"
                },
                "kind": {
                    "const": "all-day"
                },
                "occurs_on": {
                    "$ref": "#/$defs/%23Date"
                }
            },
            "required": [
                "kind",
                "occurs_on"
            ]
        },
        "#Anytime": {
            "const": {
                "kind": "anytime"
            }
        },
        "#Collection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "$ref": "#/$defs/%23CollectionID"
                },
                "kind": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "label": {
                    "type": "string",
                    "not": {
                        "pattern": "^\\s*$"
                    }
                }
            },
            "required": [
                "id",
                "kind",
                "label"
            ]
        },
        "#CollectionID": {
            "type": "string",
            "not": {
                "pattern": "^\\s*$"
            }
        },
        "#Connection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "label": {
                    "type": "string",
                    "not": {
                        "pattern": "^\\s*$"
                    }
                }
            },
            "required": [
                "id",
                "label"
            ]
        },
        "#Date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "#DueAt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "due_at": {
                    "$ref": "#/$defs/%23Timestamp"
                },
                "kind": {
                    "const": "due-at"
                }
            },
            "required": [
                "due_at",
                "kind"
            ]
        },
        "#DueOn": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "due_on": {
                    "$ref": "#/$defs/%23Date"
                },
                "kind": {
                    "const": "due-on"
                }
            },
            "required": [
                "due_on",
                "kind"
            ]
        },
        "#EntityAffordance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "capability": {
                    "$ref": "#/$defs/%23EntityCapability"
                },
                "command": {
                    "$ref": "#/$defs/%23Identifier"
                }
            },
            "required": [
                "capability",
                "command"
            ]
        },
        "#EntityCapability": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23StandardEntityCapability"
                },
                {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
            ]
        },
        "#EntryAttribution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "integration": {
                    "$ref": "#/$defs/%23Integration"
                },
                "principal_ids": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23PrincipalID"
                    }
                }
            },
            "required": [
                "principal_ids"
            ]
        },
        "#Event": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "affordances": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23EntityAffordance"
                    }
                },
                "attribution": {
                    "$ref": "#/$defs/%23EntryAttribution"
                },
                "context": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "detail": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "kind": {
                    "const": "event"
                },
                "revision": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "source": {
                    "$ref": "#/$defs/%23SourceRef"
                },
                "timing": {
                    "$ref": "#/$defs/%23EventTiming"
                },
                "title": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                }
            },
            "required": [
                "attribution",
                "id",
                "kind",
                "source",
                "timing",
                "title"
            ]
        },
        "#EventTiming": {
            "anyOf": [
                {
                    "$ref": "#/$defs/%23AllDay"
                },
                {
                    "$ref": "#/$defs/%23Timed"
                }
            ]
        },
        "#Identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "#Initiative": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "affordances": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23EntityAffordance"
                    }
                },
                "attribution": {
                    "$ref": "#/$defs/%23EntryAttribution"
                },
                "context": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "detail": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "kind": {
                    "const": "initiative"
                },
                "revision": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                },
                "source": {
                    "$ref": "#/$defs/%23SourceRef"
                },
                "state": {
                    "$ref": "#/$defs/%23InitiativeState"
                },
                "title": {
                    "type": "string",
                    "not": {
                        "const": ""
                    }
                }
            },
            "required": [
                "attribution",
                "id",
                "kind",
                "source",
                "state",
                "title"
            ]
        },
        "#InitiativeState": {
            "enum": [
                "open",
                "blocked",
                "waiting"
            ]
        },
        "#Integration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "collection": {
                    "$ref": "#/$defs/%23Collection"
                },
                "connection": {
                    "$ref": "#/$defs/%23Connection"
                }
            },
            "required": [
                "connection"
            ]
        },
        "#PluginID": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "#PrincipalID": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "#ProviderRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "plugin_id": {
                    "$ref": "#/$defs/%23PluginID"
                }
            },
            "required": [
                "plugin_id"
            ]
        },
        "#SourceRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "entity_id": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "entity_type": {
                    "$ref": "#/$defs/%23Identifier"
                },
                "plugin_id": {
                    "$ref": "#/$defs/%23PluginID"
                }
            },
            "required": [
                "entity_id",
                "entity_type",
                "plugin_id"
            ]
        },
        "#StandardEntityCapability": {
            "enum": [
                "entity.annotate",
                "entity.attach",
                "activity.read",
                "lifecycle.complete",
                "lifecycle.reopen",
                "lifecycle.acknowledge",
                "lifecycle.dismiss",
                "entity.edit",
                "entity.delete"
            ]
        },
        "#Timed": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ends_at": {
                    "$ref": "#/$defs/%23Timestamp"
                },
                "kind": {
                    "const": "timed"
                },
                "starts_at": {
                    "$ref": "#/$defs/%23Timestamp"
                }
            },
            "required": [
                "ends_at",
                "kind",
                "starts_at"
            ]
        },
        "#Timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        },
        "#Window": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ends_at": {
                    "$ref": "#/$defs/%23Timestamp"
                },
                "kind": {
                    "const": "window"
                },
                "starts_at": {
                    "$ref": "#/$defs/%23Timestamp"
                }
            },
            "required": [
                "ends_at",
                "kind",
                "starts_at"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "entries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23AgendaEntry"
            }
        },
        "generated_at": {
            "$ref": "#/$defs/%23Timestamp"
        },
        "provider": {
            "$ref": "#/$defs/%23ProviderRef"
        },
        "revision": {
            "type": "string",
            "not": {
                "const": ""
            }
        },
        "schema_version": {
            "const": "mission-control.agenda/v2"
        }
    },
    "required": [
        "entries",
        "generated_at",
        "provider",
        "revision",
        "schema_version"
    ]
}
